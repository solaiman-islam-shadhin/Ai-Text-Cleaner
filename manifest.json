{
  "manifest_version": 3,
  "name": "AI Text Cleaner",
  "version": "3.0.0",
  "description": "Removes AI writing patterns, symbols, filler phrases, and watermarks from copied text to make it sound natural.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": ["storage", "clipboardWrite", "clipboardRead", "activeTab", "scripting", "tabs"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Text Cleaner",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.chat.openai.com/*",
        "*://*.chatgpt.com/*",
        "*://*.claude.ai/*",
        "*://*.gemini.google.com/*",
        "*://*.bard.google.com/*",
        "*://*.copilot.microsoft.com/*",
        "*://*.bing.com/*",
        "*://*.perplexity.ai/*",
        "*://*.you.com/*",
        "*://*.poe.com/*",
        "*://*.character.ai/*",
        "*://*.deepseek.com/*",
        "*://*.mistral.ai/*",
        "*://*.huggingface.co/*",
        "*://*.cohere.com/*",
        "*://*.writesonic.com/*",
        "*://*.jasper.ai/*",
        "*://*.copy.ai/*",
        "*://*.rytr.me/*",
        "*://*.notion.so/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.chat.openai.com/*",
        "*://*.chatgpt.com/*",
        "*://*.claude.ai/*",
        "*://*.gemini.google.com/*",
        "*://*.bard.google.com/*",
        "*://*.copilot.microsoft.com/*",
        "*://*.bing.com/*",
        "*://*.perplexity.ai/*",
        "*://*.you.com/*",
        "*://*.poe.com/*",
        "*://*.character.ai/*",
        "*://*.deepseek.com/*",
        "*://*.mistral.ai/*",
        "*://*.huggingface.co/*",
        "*://*.cohere.com/*",
        "*://*.writesonic.com/*",
        "*://*.jasper.ai/*",
        "*://*.copy.ai/*",
        "*://*.rytr.me/*",
        "*://*.notion.so/*"
      ],
      "js": ["clipboard-interceptor.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
